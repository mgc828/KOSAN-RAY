# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL of the application
APP_URL="http://localhost:3000"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-key"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="kost-hunt-media"
R2_PUBLIC_DOMAIN="https://pub-yourdomain.r2.dev"

# Midtrans Payment Gateway (Sandbox mode for MVP)
MIDTRANS_SERVER_KEY="SB-Mid-server-your-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your-key"
MIDTRANS_IS_PRODUCTION="false"

# Admin Access Passcode for MVP
ADMIN_ACCESS_TOKEN="kosthunt-admin-secret-2026"

# Login Google (opsional) - Client ID dari Google Cloud Console (OAuth 2.0, Web application)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Email "Lupa kata sandi" (opsional) - dikirim lewat Resend. Tanpa ini, tautan hanya muncul di log server.
RESEND_API_KEY=""
EMAIL_FROM="kost-kostan <halo@kost-kostan.id>"

# Rahasia untuk menandatangani cookie login. WAJIB di produksi (minimal 16 karakter acak).
SESSION_SECRET=""

# Rahasia untuk endpoint terjadwal pengingat langganan (/api/cron/reminders). Di Vercel otomatis dikirim sebagai Bearer.
CRON_SECRET=""

# Alamat email yang menerima pesan dari formulir Kontak
SUPPORT_EMAIL="halo@kost-kostan.id"

# Google Analytics 4 (opsional; hanya aktif setelah pengunjung menyetujui cookie)
NEXT_PUBLIC_GA_ID=""

# Hanya untuk mencoba alur bayar TANPA Midtrans di server produksi (jangan dipakai di situs publik!)
# ALLOW_PAYMENT_SIMULATION="1"
